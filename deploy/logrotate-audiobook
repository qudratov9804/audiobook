# Example logrotate config for the Supervisor worker log.
# Laravel's own application log rotates itself when LOG_CHANNEL=daily (see .env).
# Copy to /etc/logrotate.d/audiobook

/var/www/audiobook/storage/logs/worker.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
